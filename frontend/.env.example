# Opportunity Radar V2 — Environment Variables
# Copy this file to .env.local for local development
# NEVER commit .env.local to source control

# =============================================================================
# Supabase
# =============================================================================
# NEXT_PUBLIC_* values are safe to expose to the browser when configured
# correctly in Supabase; service-role credentials must remain server-side.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only — never expose to client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# =============================================================================
# AI Providers
# =============================================================================
# Server-side only — these credentials must never be exposed to the browser.
# Gemini model selection is configured by the application; this variable only
# supplies the provider credential.
GEMINI_API_KEY=your-gemini-api-key-here

# Fallback providers — server-side only.
GROQ_API_KEY=your-groq-api-key-here
OPENROUTER_API_KEY=your-openrouter-api-key-here

# =============================================================================
# Opportunity Ingestion
# =============================================================================
# Kill switch for the nightly opportunity scraping pipeline.
# In production the pipeline REFUSES TO RUN unless this is exactly "true" —
# without it, no opportunities are ever added, updated or expired, and the
# cron endpoints return HTTP 503.
# Ignored outside production, so local dev and tests run without it.
ENABLE_OPP_INGESTION=true

# =============================================================================
# Application
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sentry (production only)
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# App version (set automatically in CI)
# NEXT_PUBLIC_APP_VERSION=1.0.0

# Internship-matching agent (job-server). Service-to-service only — never
# expose this to the browser. Local dev: http://localhost:4300
AI_AGENT_URL=http://localhost:4300

# ── Cron ─────────────────────────────────────────────────────────────────
# Server-side only. Vercel sends it as "Authorization: Bearer <value>" on every
# scheduled call. Every /api/cron/* route returns 503 while it is unset.
CRON_SECRET=

# ── Bot protection (Cloudflare Turnstile) ───────────────────────────────
# Set BOTH or NEITHER. With neither, login and signup run without the widget.
# With only one, login and signup are refused (see auth-actions.ts).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── AI voice interview (LiveKit + interview agent) ──────────────────────
# Server-side only.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
INTERVIEW_AGENT_URL=
INTERVIEW_AGENT_INTERNAL_SECRET=

# ── AI Search agent ─────────────────────────────────────────────────────
# Shared secret sent to the agent at AI_AGENT_URL. Server-side only.
AI_AGENT_INTERNAL_SECRET=

# ── Optional extra AI providers (server-side only) ──────────────────────
MISTRAL_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
