{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@reactive-resume/schema": ["./packages/schema/src/index.ts"],
      "@reactive-resume/schema/*": ["./packages/schema/src/*"],
      "@reactive-resume/utils": ["./packages/utils/src/index.ts"],
      "@reactive-resume/utils/*": ["./packages/utils/src/*"],
      "@reactive-resume/fonts": ["./packages/fonts/src/index.ts"],
      "@reactive-resume/fonts/*": ["./packages/fonts/src/*"],
      "@reactive-resume/resume": ["./packages/resume/src/index.ts"],
      "@reactive-resume/resume/*": ["./packages/resume/src/*"],
      "@reactive-resume/pdf": ["./packages/pdf/src/index.ts"],
      "@reactive-resume/pdf/*": ["./packages/pdf/src/*"],
      "@reactive-resume/ui": ["./packages/ui/src/index.ts"],
      "@reactive-resume/ui/*": ["./packages/ui/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "scripts",
    ".next",
    "packages/**/*.test.ts",
    "packages/**/*.test.tsx",
    "packages/**/vitest.config.ts"
  ]
}
